{
  "hosting": {
    "public": "web",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/app-config.js",
        "run": {
          "serviceId": "backend",
          "region": "europe-southwest1",
          "pinTag": true
        }
      }
    ]
  }
}
